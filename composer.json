    "keywords": ["lpv", "lean-package-validator", "mcp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "type": "project",
    "require": {
        "php": ">=8.2",
        "stolt/lean-package-validator": "^6.0",
        "php-mcp/server": "^3.3",
        "php-mcp/client": "^1.0",
        "symfony/process": "^8.1"
    },
    "autoload": {
