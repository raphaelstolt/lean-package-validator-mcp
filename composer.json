{
    "name": "stolt/lean-package-validator-mcp",
    "description": "A MCP server exposing lean-package-validator commands as tools.",
    "keywords": ["lpv", "lean-package-validator", "mcp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "type": "project",
    "require": {
        "php": ">=8.2",
        "stolt/lean-package-validator": "^6.0",
        "php-mcp/server": "^3.3",
        "symfony/process": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Stolt\\LeanPackageValidatorMcp\\": "src/"
        }
    },
    "bin": [
        "bin/server.php"
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "carthage-software/mago": "^1.48.1"
    },
    "scripts": {
        "test": "phpunit",
        "cs-lint": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": "mago format",
        "pre-commit-check": [
            "@cs-lint",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs the test suite.",
        "cs-lint": "Checks the code for coding-standard violations.",
        "cs-fix": "Fixes the coding-standard violations which can be fixed automatically.",
        "pre-commit-check": "Runs all checks which are also run in CI."
    }
}
